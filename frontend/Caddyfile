{
	admin off
}

# A loopback-only health listener works for both HTTP and HTTPS site addresses.
http://127.0.0.1:8081 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}
	@publicCoupon path /c /c/*
	handle @publicCoupon {
		root * /srv
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow, noarchive"
		rewrite * /index.html
		file_server
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
