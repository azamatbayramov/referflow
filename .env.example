# Local development only. Copy to .env with `make init`.
COMPOSE_PROJECT_NAME=referflow
PGDATABASE=referflow
PGUSER=referflow
PGPASSWORD=local-development-only
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=disable
HTTP_ADDR=127.0.0.1:8081
LOG_LEVEL=info
API_PORT=8081
WEB_PORT=8080
APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL=12h
