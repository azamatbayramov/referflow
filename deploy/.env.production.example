# Copy to repository-root .env.production; never commit that file.
# Set the actual DNS hostname, without scheme or path. Caddy obtains HTTPS.
SITE_ADDRESS=
# The complete sha-<40-character commit SHA> tag from a successful main CI run.
IMAGE_TAG=
# Generate with: openssl rand -hex 32
PGPASSWORD=
PGDATABASE=referflow
PGUSER=referflow
LOG_LEVEL=info
SESSION_TTL=12h
